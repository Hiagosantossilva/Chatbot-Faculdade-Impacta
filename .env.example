# Gere suas chaves nos links do README. Somente o servidor lê este arquivo.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free,openrouter/free

# HF opcional: exige créditos atualmente; desativado por padrão.
LLM_ENABLE_HF=false
HF_TOKEN=
HF_MODEL=Qwen/Qwen3-4B-Instruct-2507

LLM_TIMEOUT_MS=8000
LLM_TOTAL_TIMEOUT_MS=35000
PORT=3000

# Respostas curtas; teto inclui raciocínio interno quando o modelo o utiliza.
LLM_MAX_OUTPUT_TOKENS=384
LLM_MAX_ATTEMPTS=4

# Proteção por navegador (cookie assinado) + IP, aplicada somente no servidor.
# Gere uma chave estável com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem valor explícito, usa a chave privada do provedor como segredo local.
RATE_LIMIT_SECRET=
CHAT_BROWSER_DAILY=20
CHAT_IP_DAILY=30
CHAT_GLOBAL_DAILY=40
CHAT_GLOBAL_MONTHLY=1500
CHAT_TOKEN_DAILY=50000
CHAT_TOKEN_MONTHLY=1600000

# Local: arquivo persistente; produção com várias instâncias/Vercel: Redis obrigatório.
# Em um único servidor Node com disco persistente, RATE_LIMIT_STORE=file é permitido.
RATE_LIMIT_STORE=auto
RATE_LIMIT_FILE=.data/usage.json
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
